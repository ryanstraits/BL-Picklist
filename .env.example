# BrickLink Store API credentials (OAuth 1.0a).
# Generate these at https://www.bricklink.com/v2/api/register_consumer.page
# and register the access token against IP 0.0.0.0 — Netlify Functions
# don't have a fixed outbound IP, and BrickLink supports 0.0.0.0 as a
# wildcard for cloud-hosted apps.
#
# Treat these as sensitive as an API key that can move money.
BL_CONSUMER_KEY=
BL_CONSUMER_SECRET=
BL_TOKEN=
BL_TOKEN_SECRET=
